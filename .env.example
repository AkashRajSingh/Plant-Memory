# --- Groq (free LLM API) -----------------------------------------------------
# Key from https://console.groq.com/keys
GROQ_API_KEY=
# Model. Free tier: ~1,000 requests/day,
# ~8k tokens/min, so a full build is rate-limited and waits automatically. Faster: openai/gpt-oss-20b.
# `python -m plant_memory llm-check` lists the models your key can use.
GROQ_MODEL=openai/gpt-oss-120b
PLANT_MEMORY_LLM_BATCH=8

# --- Neo4j (knowledge graph store) -------------------------------------------
# From Neo4j Desktop: start your instance, copy its connection URI and the password you set.
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# auto = Neo4j when NEO4J_PASSWORD is set, otherwise SQLite (data/plant_memory.db)
PLANT_MEMORY_STORE=auto

# Answers backed by fewer events than this are flagged as sparse evidence
PLANT_MEMORY_SPARSE_THRESHOLD=3
